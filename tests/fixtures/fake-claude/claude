#!/usr/bin/env node
import { spawn } from "node:child_process";
import { appendFileSync, rmSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const mode = process.env.FAKE_CLAUDE_MODE ?? "success";

// Test-only, bounded override for the filename written by "success_with_file"
// (default unchanged: "provider-created.txt"). Deliberately restrictive —
// this is a test fixture, not a production path-resolution abstraction.
const DEFAULT_OUTPUT_FILE = "provider-created.txt";

function resolveOutputFile() {
  const override = process.env.FAKE_CLAUDE_OUTPUT_FILE;
  if (override === undefined || override.length === 0) {
    return DEFAULT_OUTPUT_FILE;
  }
  const isAbsolute = override.startsWith("/") || override.startsWith("\\");
  const hasTraversal = override.split(/[\\/]/).includes("..");
  const isSimpleRelativeName =
    !override.includes("/") && !override.includes("\\");
  if (isAbsolute || hasTraversal || !isSimpleRelativeName) {
    process.stderr.write(
      "FAKE_CLAUDE_OUTPUT_FILE must be a simple relative filename (no absolute path, no '..').\n",
    );
    process.exit(1);
  }
  return override;
}

const captureArgsPath = process.env.FAKE_CLAUDE_CAPTURE_ARGS;
if (captureArgsPath) {
  writeFileSync(captureArgsPath, JSON.stringify(process.argv.slice(2)));
}
const cwd = process.cwd();
const captureCwdPath = process.env.FAKE_CLAUDE_CAPTURE_CWD;
if (captureCwdPath) {
  writeFileSync(captureCwdPath, cwd);
}

const descendantPidPath = process.env.FAKE_CLAUDE_DESCENDANT_PID_PATH;
if (descendantPidPath) {
  // Dedicated V25.0 adversarial seam. The presence of the unique PID-file
  // destination is the trigger so this test cannot race with other suites that
  // temporarily change FAKE_CLAUDE_MODE on the shared process environment.
  const descendant = spawn(
    process.execPath,
    [
      "-e",
      "process.on('SIGTERM', () => {}); setInterval(() => {}, 1000);",
    ],
    { stdio: "ignore" },
  );
  if (descendant.pid !== undefined) {
    writeFileSync(descendantPidPath, String(descendant.pid));
  }
  setInterval(() => {}, 1000);
}

function write(payload) {
  process.stdout.write(JSON.stringify(payload));
}

switch (mode) {
  case "success": {
    write({ subtype: "success", is_error: false, num_turns: 1 });
    process.exit(0);
    break;
  }
  case "is_error": {
    write({ subtype: "error_during_execution", is_error: true, num_turns: 1 });
    process.exit(0);
    break;
  }
  case "max_turns": {
    write({
      subtype: "error_max_turns",
      is_error: true,
      terminal_reason: "max_turns",
      num_turns: 21,
      errors: ["Reached maximum number of turns (20)"],
    });
    process.exit(1);
    break;
  }
  case "invalid_json": {
    process.stdout.write("not json at all");
    process.exit(0);
    break;
  }
  case "nonzero_exit": {
    write({ subtype: "error", is_error: true });
    process.exit(1);
    break;
  }
  case "nonzero_exit_with_file": {
    writeFileSync(join(cwd, "provider-leftover.txt"), "leftover\n");
    write({ subtype: "error", is_error: true });
    process.exit(1);
    break;
  }
  case "hang": {
    setInterval(() => {}, 1000);
    break;
  }
  case "success_with_file": {
    const outputFile = resolveOutputFile();
    writeFileSync(join(cwd, outputFile), "created\n");
    write({ subtype: "success", is_error: false, num_turns: 1 });
    process.exit(0);
    break;
  }
  case "success_with_forbidden_content": {
    writeFileSync(join(cwd, "provider-created.md"), "Docker configuration\n");
    write({ subtype: "success", is_error: false, num_turns: 1 });
    process.exit(0);
    break;
  }
  case "success_with_modified_and_file": {
    appendFileSync(join(cwd, "README.md"), "modified\n");
    writeFileSync(join(cwd, "provider-created.txt"), "created\n");
    write({ subtype: "success", is_error: false, num_turns: 1 });
    process.exit(0);
    break;
  }
  case "success_with_deleted_file": {
    rmSync(join(cwd, "README.md"));
    write({ subtype: "success", is_error: false, num_turns: 1 });
    process.exit(0);
    break;
  }
  default: {
    process.exit(1);
  }
}
