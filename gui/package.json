{
  "name": "loop-engine-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GUI Cockpit — Electron desktop shell for Loop Engine. Isolated package: never installed or built by the root repo. See docs/architecture/gui-cockpit.md.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-copy-static.mjs",
    "start": "pnpm run build && electron dist/main/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "electron": "^33.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron"]
  }
}
