{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist/preload-cjs",
    "rootDir": "."
  },
  "include": ["main/preload.ts", "main/preload-api.ts", "shared/ipc-channels.ts"]
}
